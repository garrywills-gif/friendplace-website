# Emergent deploy pipeline requirement: .env files MUST NOT be excluded
# from the deploy context. Runtime env values are injected by the
# platform's secret manager at build time — the pipeline still needs
# to see the .env stubs in the repo to know the shape of the config.
# (Previously these were listed here; removed 11 Aug 2026 after the
# deployment health check flagged them as a blocker.)
credentials.json
*.key
.credentials

# Internal development notes / handoff docs — should not appear in public repo
/memory/
/test_reports/
/test_result.md
JOURNEY_CONTINUITY.md

# Emergent platform internals (cron dispatch scripts, PRD summary) — not
# needed in a public marketing/website repo, keep them local to the pod.
.emergent/

# Founders Wall cleanup — never commit prod creds
backend/scripts/_prod_creds.env
backend/scripts/_run_prod_dryrun.sh
# Ignore all real .env files — they contain secrets. Deploy-time
# templates live at frontend/.env.example and backend/.env.example
# (tracked, no secrets, safe to ship in the deploy context).
.env
.env.*
*.env
# Explicitly keep the safe stub/example templates ignored-list-exempt.
!.env.example
!*.env.example
!frontend/.env.example
!backend/.env.example
