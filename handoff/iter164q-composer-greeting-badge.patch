@@ -352,6 +401,8 @@ function ComposePanel() {
     return () => { if (debounceRef.current) clearTimeout(debounceRef.current); };
   }, [
     name, template, subject, preheader, companion, title, bodyMd, ctaLabel, ctaUrl,
