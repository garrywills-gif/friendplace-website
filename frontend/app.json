{
  "expo": {
    "name": "YouBelong",
    "slug": "youbelong",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "youbelong",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.youbelong.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Find neighbours near your suburb",
        "NSPhotoLibraryUsageDescription": "Share photos in the Coffee Lounge",
        "NSCameraUsageDescription": "Take photos to share in chats and groups",
        "NSMicrophoneUsageDescription": "Record short voice notes for friends",
        "NSContactsUsageDescription": "Find friends you already know",
        "NSUserTrackingUsageDescription": "We never track you across other apps",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationCategoryType": "public.app-category.social-networking",
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.youbelong.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A2540"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "READ_MEDIA_IMAGES",
        "CAMERA",
        "RECORD_AUDIO",
        "READ_CONTACTS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0A2540"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
